# ---- Copy this file to `.env` and fill in the values. Never commit `.env`. ----

# --- LLM endpoint (provided Qwen3-8B, Track B group 046-065) ---
OPENAI_BASE_URL=https://103.42.50.41:1034/v1
OPENAI_API_KEY=your-group-api-key-here
MODEL_NAME=Qwen/Qwen3-8B
OPENAI_CA_CERT=./vm04-ca.crt          # path to the provided CA certificate

# --- Generation limits (endpoint caps: 8192 total tokens, output 512 default / 1024 max) ---
MAX_OUTPUT_TOKENS=1024
TOKEN_BUDGET=12000                    # per-question budget across all LLM calls
RATE_LIMIT_PER_MIN=60
MAX_CONCURRENCY=1                     # endpoint allows only 1 active request per key
QWEN_DISABLE_THINKING=true           # strip/avoid Qwen3 <think> blocks for structured output

# --- Embeddings + reranker (run locally; no embeddings endpoint is provided) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Vector store (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finsight

# --- Agent / memory ---
MEMORY_DB=./store/memory.sqlite
MAX_STEPS=10

# --- Tracing (Langfuse; optional — leave blank to fall back to trace.jsonl) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
